{
  "manifest_version": 3,
  "name": "HeoBrain 비공개 초안 실행기",
  "description": "원고 승인①에서 선택한 초안만 비공개 보관합니다. 공개·예약 발행 없음.",
  "version": "0.1.1",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.threads.com/*",
    "https://onethingflow.tistory.com/*",
    "https://blog.naver.com/*",
    "https://business.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
